# Cloudflare Pages caching rules.
#
# There is no build step here, so filenames never get a content hash and a
# browser would happily keep running last week's app.js after a deploy.
# "no-cache" does NOT mean "don't cache" — it means revalidate before use, so
# an unchanged file still costs only a 304.

# Code and data change on every deploy / price refresh.
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache
/data/*
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/home
  Cache-Control: no-cache
/packs
  Cache-Control: no-cache
/bulk
  Cache-Control: no-cache
/binder
  Cache-Control: no-cache
/catalog
  Cache-Control: no-cache
/account
  Cache-Control: no-cache
/u
  Cache-Control: no-cache
/u/*
  Cache-Control: no-cache
/signin
  Cache-Control: no-cache
/settings
  Cache-Control: no-cache
/notes
  Cache-Control: no-cache
/api/*
  Cache-Control: no-store

# Card scans, foil textures and pack art are content-stable: a card's art never
# changes under the same filename, so these can be cached hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ...except the brand art, which is the one thing that does get redrawn under
# the same name. Listed after the wildcard so it wins. The ?v= on the tags in
# index.html is what frees anyone already holding a year-long copy.
/assets/mark.png
  Cache-Control: no-cache
/assets/icon-32.png
  Cache-Control: no-cache
/assets/icon-180.png
  Cache-Control: no-cache
/assets/avatar.png
  Cache-Control: no-cache
/assets/avatar-round.png
  Cache-Control: no-cache
/assets/og.jpg
  Cache-Control: no-cache
