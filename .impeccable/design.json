  "narrative": {
    "northStar": "The Card Print Proof",
    "overview": "The interface treats a pack opening like a proof laid out at a press table. Deep blue surrounds real wrapper and card art; a saturated blue stage frames the featured pack, while cool paper panels make sets and collection data easy to read. Coral marks the opening action. Small registration corners, fine trim rules, and compact tabs provide the print-shop character.\n\nThe pace is direct: the wrapper, set choice, and opening action appear together. The same materials continue through pack selection, collection tools, and the reveal overlay. The product keeps its fan-made mark, real card scans, and existing foil effects.",
    "keyCharacteristics": [
      "Saturated blue stage around real pack and card imagery.",
      "Paper panels against a dark press-table field.",
      "Compact, label-like controls and fine print-rule details.",
      "Card art remains the focal point during opening and reveal."
    ],
    "rules": [
      {
        "name": "The Action Color Rule",
        "body": "Use coral for the primary opening path and gold for coin or reward information.",
        "section": "colors"
      },
      {
        "name": "The Artwork Leads Rule",
        "body": "Large display type introduces the action; the wrapper and card scan carry the visual detail.",
        "section": "typography"
      },
      {
        "name": "The Proof Surface Rule",
        "body": "Keep ordinary information panels flat; reserve stronger depth for the featured physical objects and overlay layers.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep real wrapper and card artwork prominent inside the press-blue opening stage.",
      "Do use paper surfaces for dense set and collection information.",
      "Do carry small trim lines and registration marks where they clarify the proof-sheet structure.",
      "Do retain the gold keyboard focus outline and reduced-motion behavior."
    ],
    "donts": [
      "Don't turn every card into a floating, glowing tile; flat paper and blue panels are the repeated treatment.",
      "Don't use gold as the primary pack-opening action color; coral marks that path.",
      "Don't let decorative press marks compete with card art or printed odds."
    ]
  }
}
