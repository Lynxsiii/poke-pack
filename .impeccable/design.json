      "css": ".ds-nav{display:flex;gap:2px;background:#0f1c33;padding:4px;font-family:Sora,system-ui,sans-serif}.ds-nav-item{display:inline-flex;align-items:center;min-height:40px;padding:9px 12px;border-radius:5px;color:var(--muted,#b9c6da);font-size:13px;line-height:1.1;font-weight:700;text-decoration:none}.ds-nav-item:hover{color:#fff;background:#24395d}.ds-nav-item.ds-active{color:#102049;background:var(--paper,#e9edf2)}.ds-nav-item:focus-visible{outline:3px solid var(--gold,#ffd45c);outline-offset:3px}"
