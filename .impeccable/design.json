      "css": ".ds-ghost{background:transparent;color:var(--ink,#f7f7f0);border:1px solid #6980a6;border-radius:6px;padding:14px 18px;font-family:Sora,system-ui,sans-serif;font-weight:700;cursor:pointer}.ds-ghost:hover{background:#20365c}.ds-ghost:focus-visible{outline:3px solid var(--gold,#ffd45c);outline-offset:3px}"
