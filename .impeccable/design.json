      "css": ".ds-tabs{display:flex;gap:7px}.ds-tab{background:#20365c;color:var(--muted,#b9c6da);border:1px solid #4f6893;border-radius:3px;padding:9px 11px;font-family:Sora,system-ui,sans-serif;font-size:12px;font-weight:700;cursor:pointer}.ds-tab:hover{background:#2c4775;color:#fff}.ds-tab.ds-active{background:var(--paper,#e9edf2);color:#17233d;border-color:var(--paper,#e9edf2)}.ds-tab:focus-visible{outline:3px solid var(--gold,#ffd45c);outline-offset:3px}"
    },
    {
      "name": "Pack Card",
      "kind": "card",
      "refersTo": "pack-card",
      "description": "Paper pack information card with a compact buy action.",
      "html": "<article class=\"ds-pack\"><div class=\"ds-pack-tag\">Current expansion</div><h3>Featured booster</h3><p>Eleven cards per pack</p><div class=\"ds-pack-foot\"><strong>100 coins</strong><button>Open pack</button></div></article>",
      "css": ".ds-pack{background:var(--paper,#e9edf2);color:#14223d;border:0;border-radius:6px;padding:20px;font-family:Sora,system-ui,sans-serif;max-width:270px;transition:background .2s ease,transform .2s ease}.ds-pack:hover{background:#f8fafc;transform:translateY(-3px)}.ds-pack-tag{color:#2a4a80;font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:700}.ds-pack h3{font-family:'Archivo Black',Sora,sans-serif;font-size:24px;margin:14px 0 8px}.ds-pack p{color:#465b78;font-size:13px}.ds-pack-foot{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #b9c9dd;padding-top:14px}.ds-pack-foot strong{color:#162c54}.ds-pack-foot button{background:var(--rip,#ff7860);color:#1c1c24;border:0;border-radius:6px;padding:10px 16px;font-weight:700;cursor:pointer}.ds-pack-foot button:hover{background:#ff9a80}.ds-pack-foot button:focus-visible{outline:3px solid var(--gold,#ffd45c);outline-offset:3px}"
    },
